# Home Assistant Secrets
# Copy this file to secrets.yaml and configure

# PostgreSQL (recorder)
# Same value as POSTGRES_PASSWORD in stacks/home-automation/.env
postgres_password: your_postgres_password
# Used by recorder.db_url in configuration.yaml
postgres_db_url: postgresql://hass:<postgres_password>@<db-host>:5432/homeassistant

# Nanit camera (ffmpeg camera input)
nanit_rtmp_url: rtmp://<bridge-host>:1935/local/<camera-id>
