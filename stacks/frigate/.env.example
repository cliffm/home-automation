# Timezone
TIMEZONE=America/New_York

# MQTT credentials Frigate uses to connect to Mosquitto
FRIGATE_MQTT_USER=frigate
FRIGATE_MQTT_PASSWORD=change_me

# UniFi Protect stream URLs (Protect > camera > Settings > RTSPS).
# Protect shows rtsps://HOST:7441/TOKEN?enableSrtp; write it for go2rtc as
# rtspx://HOST:7441/TOKEN. The token is a credential: keep it out of git.
# Low/medium stream, used for detection:
FRIGATE_RTSP_DOORBELL=rtspx://192.168.1.1:7441/TOKEN
FRIGATE_RTSP_FRONT_DOOR=rtspx://192.168.1.1:7441/TOKEN
# High stream, used for recordings:
FRIGATE_RTSP_DOORBELL_HIGH=rtspx://192.168.1.1:7441/TOKEN
FRIGATE_RTSP_FRONT_DOOR_HIGH=rtspx://192.168.1.1:7441/TOKEN
